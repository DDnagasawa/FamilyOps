{
  "name": "codex-general-local-agent",
  "version": "0.1.0",
  "description": "Codex-powered general local agent platform MVP with skills, tools, permissions, audit logs, and Lark push.",
  "type": "module",
  "scripts": {
    "agent": "node src/cli.js",
    "briefing": "node src/cli.js run daily_briefing",
    "briefing:lark": "env LARK_DRY_RUN=false node src/cli.js run daily_briefing '{\"sendLark\":true,\"includeRealSources\":true}'",
    "project": "node src/cli.js run project_summary",
    "family": "node src/cli.js run family_reminder",
    "family:plan": "node src/cli.js run family_coordinator",
    "family:todo": "node src/cli.js run family_todo_list",
    "research": "node src/cli.js run research_summary",
    "web:research": "node src/cli.js run web_research_report",
    "web:research:lark": "env LARK_DRY_RUN=false node src/cli.js run web_research_report",
    "social:draft": "node src/cli.js run social_media_draft",
    "project:update": "node src/cli.js run project_task_update",
    "project:sync": "node src/cli.js run project_management_sync",
    "github:summary": "node src/cli.js run github_project_summary",
    "github:public": "node src/cli.js run github_public_project_summary",
    "rss:news": "node src/cli.js run rss_news_briefing",
    "files:organize": "node src/cli.js run local_file_organisation",
    "folders:scan": "node src/cli.js run folder_monitoring",
    "script:run": "node src/cli.js run local_script_execution",
    "social:publish": "node src/cli.js run social_media_publishing_request",
    "list:skills": "node src/cli.js skills",
    "list:tools": "node src/cli.js tools",
    "test:lark": "node src/cli.js tool send_lark_message '{\"text\":\"Codex local agent Lark test\"}'",
    "jobs": "node src/cli.js jobs",
    "daemon:once": "node src/cli.js daemon --once",
    "history": "node src/cli.js history",
    "profiles": "node src/cli.js profiles",
    "memory": "node src/cli.js memory",
    "memory:set": "node src/cli.js memory:set",
    "memory:learning": "node src/cli.js memory:learning",
    "memory:review": "node src/cli.js memory:review",
    "connectors": "node src/cli.js connectors",
    "lark:chats": "node src/cli.js lark chats",
    "codex:prompts": "node src/cli.js codex:prompts",
    "codex:prompt": "node src/cli.js codex:prompt",
    "validate:lark": "node src/cli.js validate lark",
    "validate:github": "node src/cli.js validate github",
    "validate:github-public": "node src/cli.js validate github_public",
    "validate:rss": "node src/cli.js validate rss_news",
    "callback:server": "node src/cli.js callback:server",
    "app:server": "node src/cli.js app:server",
    "dashboard": "node src/cli.js dashboard",
    "launchd:plist": "node src/cli.js launchd:plist",
    "launchd:callback-plist": "node src/cli.js launchd:callback-plist",
    "test": "node --test tests/smoke.test.js tests/memoryLearning.test.js tests/familyMemberResolution.test.js tests/familyAccountLinking.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
