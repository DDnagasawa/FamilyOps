# Runtime
RUN_MODE=codex_automation
NODE_ENV=development

# AI provider
# Default path is Codex-in-the-loop with local rule fallback.
# Set AI_PROVIDER to openai, doubao, anthropic, gemini, or ollama only when you want the App backend to call a model directly.
AI_PROVIDER=codex_in_the_loop

# Shared model adapter limits
MODEL_ADAPTER_TIMEOUT_MS=20000
MODEL_ADAPTER_RETRIES=2
MODEL_ADAPTER_MAX_OUTPUT_TOKENS=900

# OpenAI Responses API mode
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Doubao / Volcengine Ark fast JSON mode
# ARK_API_KEY=
# ARK_MODEL=doubao-seed-2-0-lite-260215
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_MODE=chat_completions

# Anthropic Claude Messages API mode
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini generateContent mode
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local model mode through Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Lark custom bot webhook
LARK_WEBHOOK_URL=replace_with_lark_custom_bot_webhook_url
LARK_SECRET=
LARK_DRY_RUN=true

# Lark self-built app API, used for querying bot-visible chats and app API sending.
LARK_APP_ID=replace_with_lark_app_id
LARK_APP_SECRET=replace_with_lark_app_secret
LARK_API_BASE_URL=https://open.larksuite.com
LARK_RECEIVE_ID_TYPE=chat_id
LARK_RECEIVE_ID=replace_with_target_chat_id
LARK_CALLBACK_VERIFICATION_TOKEN=

# Local callback server for Lark interactive card approve/reject actions.
# For real Lark callbacks, expose this through a public HTTPS tunnel and set the same path in Lark Developer Console.
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8787
CALLBACK_PATH=/lark/callback
CALLBACK_PUBLIC_URL=

# Agent behaviour
DEFAULT_SEND_LARK=false
BRIEFING_TOP_N=5
REAL_SOURCE_PATHS=README.md,data/run_history.json,data/audit.log
APPROVAL_REQUIRED_FOR=social_post,external_message,file_delete,project_update

# Web search and browser automation MVP
WEB_SEARCH_PROVIDER=duckduckgo_html
WEB_MAX_PAGE_CHARS=12000
WEB_USER_AGENT=Mozilla/5.0 (compatible; CodexGeneralLocalAgent/0.1)
RSS_FEED_URLS=https://github.blog/feed/

# Local execution MVP
LOCAL_EXECUTION_ROOT=.
LOCAL_SCRIPT_DIR=scripts/agent
FOLDER_WATCH_PATHS=data,docs,skills

# Optional integrations
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_API_BASE_URL=https://api.github.com
NOTION_TOKEN=
LINEAR_API_KEY=
SOCIAL_MEDIA_API_KEY=
